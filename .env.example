# ==============================================================================
# Ashish Enterprises (आशिष एंटरप्राइजेस) - Environment Configuration Template
# NOTE: DO NOT commit actual credentials or production secrets to source control.
# Copy this file to .env and configure local development values.
# ==============================================================================

# Database Connection (PostgreSQL 17+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ashish_enterprises?schema=public"

# Application Environment
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# Authentication & Session Security (Minimum 32 random characters for production)
SESSION_SECRET="placeholder_session_secret_at_least_32_characters_long_for_dev_mode"

# Initial Development Seed Credentials (Only used by prisma/seed.ts if not yet seeded)
INITIAL_ADMIN_NAME="Ashish Admin"
INITIAL_ADMIN_EMAIL="admin@ashishenterprises.local"
INITIAL_ADMIN_PASSWORD="ReplaceWithSecurePassword123!"

# Business Contact Settings (Never invent real contact data; configured per deployment)
NEXT_PUBLIC_BUSINESS_NAME="Ashish Enterprises"
NEXT_PUBLIC_BUSINESS_NAME_MR="आशिष एंटरप्राइजेस"
NEXT_PUBLIC_BUSINESS_PHONE="+919800000000"
NEXT_PUBLIC_BUSINESS_WHATSAPP="+919800000000"
NEXT_PUBLIC_BUSINESS_LOCATION_MR="हिंगोली, महाराष्ट्र"
NEXT_PUBLIC_BUSINESS_LOCATION_EN="Hingoli, Maharashtra"
